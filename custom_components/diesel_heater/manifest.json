{
  "domain": "diesel_heater",
  "name": "Diesel Heater",
  "codeowners": ["@Spettacolo83"],
  "config_flow": true,
  "dependencies": ["bluetooth"],
  "documentation": "https://github.com/Spettacolo83/homeassistant-diesel-heater",
  "integration_type": "device",
  "issue_tracker": "https://github.com/Spettacolo83/homeassistant-diesel-heater/issues",
  "iot_class": "local_polling",
  "loggers": ["diesel_heater_ble"],
  "requirements": ["diesel-heater-ble>=0.3.6"],
  "icon": "mdi:radiator",
  "bluetooth": [
    {
      "connectable": true,
      "local_name": "BAC-*"
    },
    {
      "connectable": true,
      "local_name": "BYD-*"
    },
    {
      "connectable": true,
      "local_name": "HC-*"
    },
    {
      "connectable": true,
      "local_name": "Heater[0-9]*"
    },
    {
      "connectable": true,
      "local_name": "Hcalory*"
    },
    {
      "connectable": true,
      "local_name": "hcalory*"
    },
    {
      "connectable": true,
      "local_name": "C1:*:FE:*"
    },
    {
      "connectable": true,
      "local_name": "boygu*"
    },
    {
      "connectable": true,
      "local_name": "BOYGU*"
    }
  ],
  "version": "2.1.5-beta.11"
}
